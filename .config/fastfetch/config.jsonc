{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "color": {
      "1": 14,
      "2": 14
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": 6,
      "title": 14,
      "output": 15,
      "separator": 6
    },
    "percent": {
      "type": 1
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "at": "cyan"
      }
    },
    {
      "type": "separator",
      "outputColor": "cyan"
    },
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "battery",
    "localip",
    "bluetooth",
    "break",
    "colors"
  ]
}
