{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "light_cyan",
      "2": "light_cyan"
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "cyan",
      "title": "light_cyan",
      "output": "light_white",
      "separator": "cyan"
    },
    "percent": {
      "type": 1
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "at": "cyan"
      }
    },
    {
      "type": "separator",
      "outputColor": "cyan"
    },
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "bluetooth",
    "break",
    "colors",
    "break"
  ]
}
